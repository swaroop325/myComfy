<mxCell id="step-1-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Owner talks to the bot&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Messages and button taps reach API Gateway through the Telegram webhook (secret token checked, owner chat only).&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-1-legend"><mxGeometry height="80" width="548" x="52" as="geometry" /></mxCell>
<mxCell id="step-2-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="80" width="600" x="0" y="86" as="geometry" /></mxCell>
<mxCell id="step-2-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="2" vertex="1" parent="step-2-legend"><mxGeometry height="38" width="40" y="2" as="geometry" /></mxCell>
<mxCell id="step-2-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Bot Lambda routes and enqueues&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Dedupes the update, saves chat state in DynamoDB, enqueues a chat / episode / edit job on SQS and starts the GPU instance if it is stopped.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-2-legend"><mxGeometry height="80" width="548" x="52" as="geometry" /></mxCell>
<mxCell id="step-3-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="80" width="600" x="0" y="172" as="geometry" /></mxCell>
<mxCell id="step-3-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="3" vertex="1" parent="step-3-legend"><mxGeometry height="38" width="40" y="2" as="geometry" /></mxCell>
<mxCell id="step-3-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Worker pulls the job&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The worker service on EC2 long-polls SQS with heartbeats and runs the pipeline: Ollama LLM for script, ComfyUI SDXL stills, Piper TTS, ffmpeg assembly (1080x1920).&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-3-legend"><mxGeometry height="80" width="548" x="52" as="geometry" /></mxCell>
<mxCell id="step-4-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="80" width="600" x="0" y="258" as="geometry" /></mxCell>
<mxCell id="step-4-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="4" vertex="1" parent="step-4-legend"><mxGeometry height="38" width="40" y="2" as="geometry" /></mxCell>
<mxCell id="step-4-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Artifacts land in S3&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Scene images and audio, script.json, thumb.jpg, then final.mp4 last; the episode moves to IN_REVIEW in DynamoDB.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-4-legend"><mxGeometry height="80" width="548" x="52" as="geometry" /></mxCell>
<mxCell id="step-5-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="80" width="600" x="0" y="344" as="geometry" /></mxCell>
<mxCell id="step-5-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="5" vertex="1" parent="step-5-legend"><mxGeometry height="38" width="40" y="2" as="geometry" /></mxCell>
<mxCell id="step-5-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Review in Telegram&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The final.mp4 upload fires the notify Lambda, which sends the reel (or a presigned link) with Approve / Regenerate / Edit / Reject buttons.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-5-legend"><mxGeometry height="80" width="548" x="52" as="geometry" /></mxCell>
<mxCell id="step-6-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="80" width="600" x="0" y="430" as="geometry" /></mxCell>
<mxCell id="step-6-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="6" vertex="1" parent="step-6-legend"><mxGeometry height="38" width="40" y="2" as="geometry" /></mxCell>
<mxCell id="step-6-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Approve and publish&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Approve invokes the publish Lambda asynchronously: Instagram Reels post, or a manual hand-off message. State becomes APPROVED, then POSTED.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-6-legend"><mxGeometry height="80" width="548" x="52" as="geometry" /></mxCell>
<mxCell id="step-7-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="legend-container"><mxGeometry height="80" width="600" x="0" y="516" as="geometry" /></mxCell>
<mxCell id="step-7-badge-legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="7" vertex="1" parent="step-7-legend"><mxGeometry height="38" width="40" y="2" as="geometry" /></mxCell>
<mxCell id="step-7-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Reaper keeps the bill small&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;EventBridge runs the reaper every 5 minutes. It stops the box when idle or stuck, restarts it when jobs wait, and honours the keep-awake hold.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-7-legend"><mxGeometry height="80" width="548" x="52" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
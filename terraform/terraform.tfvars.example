# Copy this file to terraform.tfvars and fill in your values

aws_region    = "ap-southeast-1"
project_name  = "comfyui"
allowed_ip    = "YOUR_IP_ADDRESS/32"  # Your IP to whitelist (run: curl ifconfig.me)
instance_type = "g4dn.12xlarge"       # 4x T4 GPUs (~$3.91/hr on-demand)
volume_size   = 300                   # GB - ~40 GB LLM plus ComfyUI models
